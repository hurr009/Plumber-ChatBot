# --- Groq (LLM generation) ---
# Get from https://console.groq.com -> API Keys
GROQ_API_KEY=your-groq-api-key

# --- Pinecone ---
# Get from https://app.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=plumber-bot

# --- Models ---
GROQ_MODEL=llama-3.3-70b-versatile
# FastEmbed model — runs locally via ONNX, no API key, no torch.
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Dimension of the chosen embed model (all-MiniLM-L6-v2 = 384).
EMBED_DIM=384

# --- CORS ---
# Comma-separated list of origins allowed to embed/call the widget.
# Use http://localhost:3000 for local dev. Add each customer domain in prod.
ALLOWED_ORIGINS=http://localhost:3000

# --- Ingestion ---
KNOWLEDGE_PDF=data/Knowledge.pdf
PINECONE_NAMESPACE=plumber

# --- Bot identity ---
BOT_NAME=Plumber Bot
